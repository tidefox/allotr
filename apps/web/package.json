{
  "name": "@allotr/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-tokens.ts && node scripts/generate-icons.ts && vite build",
    "tokens": "node scripts/generate-tokens.ts",
    "tokens:check": "node scripts/generate-tokens.ts --check",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p src/sw",
    "test": "vitest run",
    "e2e": "pnpm run e2e:app && pnpm run e2e:components",
    "e2e:app": "pnpm run build && playwright test",
    "e2e:components": "playwright test -c playwright.components.config.ts",
    "icons": "node scripts/generate-icons.ts",
    "icons:check": "node scripts/generate-icons.ts --check"
  },
  "dependencies": {
    "@allotr/shared": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "catalog:",
    "remixicon": "4.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.4",
    "vitest": "catalog:"
  }
}
